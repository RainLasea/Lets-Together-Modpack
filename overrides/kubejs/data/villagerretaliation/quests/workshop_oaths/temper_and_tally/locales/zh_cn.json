    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.offer.response.accept.label": "我会带来锻造库存。",
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.offer.response.decline.label": "下次吧。",
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.label": "关于淬炼",
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.lines": [
      "首先是铁和煤。没有库存的热量只是室内出汗的一种方式。"
    ],
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.response.details.label": "重复伪造列表。",
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.response.leave.label": "我会带来它。",
