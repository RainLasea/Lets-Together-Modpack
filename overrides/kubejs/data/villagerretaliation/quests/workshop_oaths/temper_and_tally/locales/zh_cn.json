    ],
    "quest.workshop_oaths.temper_and_tally.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "我现在无法关闭伪造记录。"
    ],
    "quest.workshop_oaths.temper_and_tally.stage.return.scene.leave.lines": [
      "计票等待。金属具有人类所没有的耐心。"
    ],
    "quest.workshop_oaths.temper_and_tally.stage.return.ui.tracker_text": "带着锻造原料返回。",
    "quest.workshop_oaths.temper_and_tally.title": "淬炼"
  }
