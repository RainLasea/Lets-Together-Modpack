{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.workshop_oaths.temper_and_tally.description": "携带车间所需的较重材料，然后工具才能在压力下得到信赖。",
    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.dialogue.reminder.label": "关于淬炼",
    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.dialogue.reminder.lines": [
      "铁和热量足以开始。带上磨石，这样工作就可以正常结束。"
