{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.redstone_works.sun_switch.description": "用灯和测量控制电路完成白昼分支。",
    "quest.redstone_works.sun_switch.stage.return.dialogue.turn_in.label": "关于白昼",
    "quest.redstone_works.sun_switch.stage.return.dialogue.turn_in.lines": [
      "路在黄昏时醒来，在黎明后沉睡。没有村民需要记住杠杆。",
      "现在，太阳比任何值守时间表都更能保持村庄的灯光。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.redstone_works.sun_switch.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.redstone_works.sun_switch.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.redstone_works.sun_switch.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "路在黄昏时醒来，在黎明后沉睡。没有村民需要记住杠杆。",
      "现在，太阳比任何值守时间表都更能保持村庄的灯光。"
    ],
    "quest.redstone_works.sun_switch.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.redstone_works.sun_switch.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.redstone_works.sun_switch.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.redstone_works.sun_switch.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "现在白天不开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.redstone_works.sun_switch.stage.return.scene.turn_in_wait.lines": [
      "放置了八盏灯，返回了两个比较器和十二个石英。",
      "当工作准备好时再回来。"
    ],
    "quest.redstone_works.sun_switch.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.redstone_works.sun_switch.stage.work.dialogue.offer.label": "白昼",
    "quest.redstone_works.sun_switch.stage.work.dialogue.offer.lines": [
      "大门跟随白昼而行。现在路灯也应该跟随它。",
      "将灯设置在路径弯曲的地方，并为控制箱提供一种比较弱光和强光的方法。",
      "放置 8 个红石灯并带上 2 个比较器和 12 个石英。"
    ],
    "quest.redstone_works.sun_switch.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.redstone_works.sun_switch.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.redstone_works.sun_switch.stage.work.dialogue.reminder.label": "关于白昼",
    "quest.redstone_works.sun_switch.stage.work.dialogue.reminder.lines": [
      "放置了八盏灯，返回了两个比较器和十二个石英。",
      "放置 8 个红石灯并带上 2 个比较器和 12 个石英。",
      "将灯设置在路径弯曲的地方，并为控制箱提供一种比较弱光和强光的方法。"
    ],
    "quest.redstone_works.sun_switch.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.redstone_works.sun_switch.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.redstone_works.sun_switch.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.redstone_works.sun_switch.stage.work.objective.bring_comparators.tracker.complete_text": "比较器已准备就绪。",
    "quest.redstone_works.sun_switch.stage.work.objective.bring_comparators.tracker.text": "带2个红石比较器。",
    "quest.redstone_works.sun_switch.stage.work.objective.bring_quartz.tracker.complete_text": "石英已经准备好了。",
    "quest.redstone_works.sun_switch.stage.work.objective.bring_quartz.tracker.text": "带 12 个下界石英进行修理。",
    "quest.redstone_works.sun_switch.stage.work.objective.place_lamps.tracker.complete_text": "门灯已放置。",
    "quest.redstone_works.sun_switch.stage.work.objective.place_lamps.tracker.text": "沿着门路放置 8 个红石灯。",
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_confirm.lines": [
      "把白昼放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "现在白天不开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.decline.lines": [
      "然后门就可以暂时保持光亮。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.leave.lines": [
      "放置了八盏灯，返回了两个比较器和十二个石英。",
      "当工作准备好时再回来。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "放置了八盏灯，返回了两个比较器和十二个石英。",
      "放置 8 个红石灯并带上 2 个比较器和 12 个石英。",
      "将灯设置在路径弯曲的地方，并为控制箱提供一种比较弱光和强光的方法。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "现在白天不开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "现在天已经亮了。",
      "这项工作已经被计算在内。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.start_quest.action.start.lines.started": [
      "将每一盏灯都朝向道路。照亮屋顶只能帮助蝙蝠。",
      "放置 8 个红石灯并带上 2 个比较器和 12 个石英。"
    ],
    "quest.redstone_works.sun_switch.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "现在白天不开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.redstone_works.sun_switch.stage.work.ui.tracker_text": "放置 8 个红石灯并带上 2 个比较器和 12 个石英。",
    "quest.redstone_works.sun_switch.title": "白昼"
  }
}
