    "quest.deep_delvers.below_the_bell.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "钟楼下现在已经安定下来了。",
      "这项工作已经被计算在内。"
    ],
    "quest.deep_delvers.below_the_bell.stage.work.scene.start_quest.action.start.lines.locate_failed": [
