{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.deep_delvers.iron_road.description": "使用动力轨道和货运车将铁路分支推得更深。",
    "quest.deep_delvers.iron_road.stage.return.dialogue.turn_in.label": "关于铁路",
    "quest.deep_delvers.iron_road.stage.return.dialogue.turn_in.lines": [
      "铁路靠自己的力量攀登。矿井现在可以挖得更深了。",
      "装满的车出去，空的车进来。那是一座开始呼吸的矿井。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.deep_delvers.iron_road.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.deep_delvers.iron_road.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.deep_delvers.iron_road.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "铁路靠自己的力量攀登。矿井现在可以挖得更深了。",
      "装满的车出去，空的车进来。那是一座开始呼吸的矿井。"
    ],
    "quest.deep_delvers.iron_road.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.deep_delvers.iron_road.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.deep_delvers.iron_road.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.deep_delvers.iron_road.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "铁道目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.deep_delvers.iron_road.stage.return.scene.turn_in_wait.lines": [
      "八根动力轨道、八根红石火把、一辆货车。",
      "当工作准备好时再回来。"
    ],
    "quest.deep_delvers.iron_road.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.deep_delvers.iron_road.stage.work.dialogue.offer.label": "铁之路",
    "quest.deep_delvers.iron_road.stage.work.dialogue.offer.lines": [
      "第一个铁轨可以工作，但更深的斜坡会让满载的推车向后移动，而空的推车则无处可去。",
      "为陡峭的运行提供动力，并为矿井提供一辆专为货运而设计的推车。",
      "放置 8 个供电轨道，然后带上 8 个红石火把和 1 个宝箱矿车。"
    ],
    "quest.deep_delvers.iron_road.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.deep_delvers.iron_road.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.deep_delvers.iron_road.stage.work.dialogue.reminder.label": "关于铁路",
    "quest.deep_delvers.iron_road.stage.work.dialogue.reminder.lines": [
      "八根动力轨道、八根红石火把、一辆货车。",
      "放置 8 个供电轨道，然后带上 8 个红石火把和 1 个宝箱矿车。",
      "为陡峭的运行提供动力，并为矿井提供一辆专为货运而设计的推车。"
    ],
    "quest.deep_delvers.iron_road.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.deep_delvers.iron_road.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.deep_delvers.iron_road.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.deep_delvers.iron_road.stage.work.objective.bring_freight_cart.tracker.complete_text": "货运车已准备就绪。",
    "quest.deep_delvers.iron_road.stage.work.objective.bring_freight_cart.tracker.text": "带上 1 个带箱子的矿车。",
    "quest.deep_delvers.iron_road.stage.work.objective.bring_torches.tracker.complete_text": "红石火把已经准备好了。",
    "quest.deep_delvers.iron_road.stage.work.objective.bring_torches.tracker.text": "带8个红石火把。",
    "quest.deep_delvers.iron_road.stage.work.objective.power_line.tracker.complete_text": "供电导轨已设置。",
    "quest.deep_delvers.iron_road.stage.work.objective.power_line.tracker.text": "放置 8 个供电导轨。",
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_confirm.lines": [
      "把铁路放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "铁道目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.decline.lines": [
      "然后小心地推。斜坡已经选择了最喜欢的方向。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.leave.lines": [
      "八根动力轨道、八根红石火把、一辆货车。",
      "当工作准备好时再回来。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "八根动力轨道、八根红石火把、一辆货车。",
      "放置 8 个供电轨道，然后带上 8 个红石火把和 1 个宝箱矿车。",
      "为陡峭的运行提供动力，并为矿井提供一辆专为货运而设计的推车。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "铁道目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "铁道现在已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.start_quest.action.start.lines.started": [
      "在负载之前测试制动器。矿石是有耐心的；矿车则不然。",
      "放置 8 个供电轨道，然后带上 8 个红石火把和 1 个宝箱矿车。"
    ],
    "quest.deep_delvers.iron_road.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "铁道目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.deep_delvers.iron_road.stage.work.ui.tracker_text": "放置 8 个供电轨道，然后带上 8 个红石火把和 1 个宝箱矿车。",
    "quest.deep_delvers.iron_road.title": "铁之路"
  }
}
