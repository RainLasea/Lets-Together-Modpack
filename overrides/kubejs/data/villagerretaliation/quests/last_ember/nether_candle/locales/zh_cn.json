    "quest.last_ember.nether_candle.stage.bottle_heat.scene.leave.lines": [
      "瓶子里的粉末仍然是耐火的。"
    ],
    "quest.last_ember.nether_candle.stage.bottle_heat.scene.reminder_details.action.remind.lines.reminder": [
      "为下界之烛携带 4 个火焰粉和 8 个萤石粉。"
    ],
    "quest.last_ember.nether_candle.stage.bottle_heat.scene.reminder_details.action.remind.lines.unavailable": [
      "瓶装火焰可以等待点火工作完成。"
    ],
    "quest.last_ember.nether_candle.stage.bottle_heat.ui.tracker_text": "带上 4 个火焰粉和 8 个萤石粉。",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.offer.label": "下界之烛",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.offer.lines": [
      "珍珠教会了我们看向别处的形状。火教一些不太礼貌的东西。",
      "带上火焰棒，证明你面对过制造它们的东西。之后，我们仔细地总结课程。"
    ],
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.offer.response.accept.label": "我会带来地狱之火。",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.offer.response.decline.label": "还没有。",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.reminder.label": "关于下界之烛",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.reminder.lines": [
      "击败火焰并带上木棒。这个教训需要的是赢得的热量，而不是从箱子里偷来的热量。"
    ],
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.reminder.response.details.label": "重复消防工作。",
    "quest.last_ember.nether_candle.stage.bright_heat.dialogue.reminder.response.leave.label": "我会处理的。",
    "quest.last_ember.nether_candle.stage.bright_heat.objective.bring_blaze_rods.tracker.complete_text": "火焰棒已准备就绪。",
