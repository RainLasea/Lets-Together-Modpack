{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.last_ember.nether_candle.description": "将最后的余烬研究带入下界材料并了解哪些火焰值得尊重。",
    "quest.last_ember.nether_candle.stage.bottle_heat.dialogue.reminder.label": "关于下界之烛",
    "quest.last_ember.nether_candle.stage.bottle_heat.dialogue.reminder.lines": [
      "棒证明了火。现在带上粉末和萤石粉，这样就可以在不烧纸的情况下上课。"
    ],
    "quest.last_ember.nether_candle.stage.bottle_heat.dialogue.reminder.response.details.label": "重复装瓶工作。",
    "quest.last_ember.nether_candle.stage.bottle_heat.dialogue.reminder.response.leave.label": "我会带来它。",
