{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.nether_routes.fortress_line.description": "确保要塞分支免受枯萎骷髅巡逻队的侵害。",
    "quest.nether_routes.fortress_line.stage.return.dialogue.turn_in.label": "关于黑石桥梁酒店",
    "quest.nether_routes.fortress_line.stage.return.dialogue.turn_in.lines": [
      "堡垒线有标记，备有物资，而且比我们发现的要安静。",
      "一条穿过火焰和黑色骸骨的道路现在通向村庄。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.nether_routes.fortress_line.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.nether_routes.fortress_line.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.nether_routes.fortress_line.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "堡垒线有标记，备有物资，而且比我们发现的要安静。",
      "一条穿过火焰和黑色骸骨的道路现在通向村庄。"
    ],
    "quest.nether_routes.fortress_line.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.nether_routes.fortress_line.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.nether_routes.fortress_line.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.nether_routes.fortress_line.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "黑石桥梁目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.nether_routes.fortress_line.stage.return.scene.turn_in_wait.lines": [
      "五具凋灵骷髅，三十二块砖块，十六颗地狱疣。",
      "当工作准备好时再回来。"
    ],
    "quest.nether_routes.fortress_line.stage.return.ui.tracker_text": "返回任务给予者。",
