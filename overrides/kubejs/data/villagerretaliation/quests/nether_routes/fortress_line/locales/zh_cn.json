    "quest.nether_routes.fortress_line.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.nether_routes.fortress_line.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.nether_routes.fortress_line.stage.work.dialogue.reminder.response.leave.label": "我有。",
