      "老路有耐心。通常。"
    ],
    "quest.cartographers_atlas.first_far_marker.stage.survey.scene.leave.lines": [
      "注意边距。"
    ],
    "quest.cartographers_atlas.first_far_marker.stage.survey.scene.reminder_details.action.remind.lines.reminder": [
      "{target_x}、{target_z} 附近的小径遗迹，大约 {distance} 区块 {direction}。到达废墟，携带刷子，并带来8个铜锭。"
    ],
    "quest.cartographers_atlas.first_far_marker.stage.survey.scene.reminder_details.action.remind.lines.unavailable": [
