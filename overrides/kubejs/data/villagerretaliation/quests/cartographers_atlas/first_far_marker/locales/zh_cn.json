{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.cartographers_atlas.first_far_marker.description": {
      "lines": [
        "沿着第一个地图集标记前往踪迹废墟，并为 路线 镀上铜。"
      ]
    },
    "quest.cartographers_atlas.first_far_marker.event.roads_principle_kit.action.notification.text": "行车原理：第一次探险增加了指南针和铁路线套件。",
    "quest.cartographers_atlas.first_far_marker.event.wonders_principle_kit.action.notification.text": "奇迹原理：第一次探险增加了望远镜和紫水晶调查套件。",
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.reminder.label": "关于第一远标记",
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.reminder.lines": [
      "{target_x}、{target_z} 附近的小径遗迹。带上刷子和铜，这样地图集就可以停止猜测。"
    ],
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.reminder.response.details.label": "提醒我在哪里",
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.reminder.response.leave.label": "算了",
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.turn_in.label": "关于第一远标记",
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.turn_in.lines": [
      "你达到了旧的目标吗？然后告诉我道路留下了什么。"
    ],
    "quest.cartographers_atlas.first_far_marker.stage.return.dialogue.turn_in.response.complete.label": "交出现场笔记",
