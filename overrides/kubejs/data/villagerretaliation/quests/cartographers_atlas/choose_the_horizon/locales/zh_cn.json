    "quest.cartographers_atlas.choose_the_horizon.stage.started.dialogue.reminder.response.details.label": "重复叉子",
    "quest.cartographers_atlas.choose_the_horizon.stage.started.dialogue.reminder.response.leave.label": "我会选择",
