{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.cartographers_atlas.choose_the_horizon.description": {
      "lines": [
        "选择并准备地图集第一个伟大的主世界 路线。"
      ]
    },
    "quest.cartographers_atlas.choose_the_horizon.scene.atlas_horizon_choice.metadata.title": "地图册的远方抉择",
