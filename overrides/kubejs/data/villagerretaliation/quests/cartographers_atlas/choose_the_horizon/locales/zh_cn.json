    "quest.cartographers_atlas.choose_the_horizon.stage.started.dialogue.offer.response.decline.label": "另一次",
    "quest.cartographers_atlas.choose_the_horizon.stage.started.dialogue.reminder.label": "关于地平线",
    "quest.cartographers_atlas.choose_the_horizon.stage.started.dialogue.reminder.lines": [
      "这个永久的主世界分叉关闭了另一个 路线：海岸准备进行纪念碑调查；黑暗的屋顶准备进行豪宅调查。"
