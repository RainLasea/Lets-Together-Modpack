    "quest.end_survey.empty_sky.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.end_survey.empty_sky.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.end_survey.empty_sky.stage.work.dialogue.reminder.response.leave.label": "我有。",
