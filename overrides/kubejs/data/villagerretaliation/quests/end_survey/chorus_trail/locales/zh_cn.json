    "quest.end_survey.chorus_trail.stage.work.scene.abandon_confirm.lines": [
      "把合唱放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.end_survey.chorus_trail.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.end_survey.chorus_trail.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.end_survey.chorus_trail.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.end_survey.chorus_trail.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
