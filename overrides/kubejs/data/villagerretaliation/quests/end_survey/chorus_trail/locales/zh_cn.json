    ],
    "quest.end_survey.chorus_trail.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.end_survey.chorus_trail.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.end_survey.chorus_trail.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.end_survey.chorus_trail.stage.work.objective.bring_end_stone.tracker.complete_text": "末地石已准备就绪。",
