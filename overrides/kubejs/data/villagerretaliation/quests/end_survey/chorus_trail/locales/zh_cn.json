{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.end_survey.chorus_trail.description": "通过收获花朵和煮熟的水果来绘制合唱分支的地图。",
    "quest.end_survey.chorus_trail.stage.return.dialogue.turn_in.label": "关于紫颂",
    "quest.end_survey.chorus_trail.stage.return.dialogue.turn_in.lines": [
      "合唱轨迹从根到花进行映射。生活分支已完成。",
      "我们可以在外端生长一小块，让档案馆可以观看它。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.end_survey.chorus_trail.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.end_survey.chorus_trail.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.end_survey.chorus_trail.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "合唱轨迹从根到花进行映射。生活分支已完成。",
      "我们可以在外端生长一小块，让档案馆可以观看它。"
    ],
    "quest.end_survey.chorus_trail.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.end_survey.chorus_trail.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.end_survey.chorus_trail.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.end_survey.chorus_trail.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "紫颂现在没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.end_survey.chorus_trail.stage.return.scene.turn_in_wait.lines": [
      "收获了八朵花，十六颗爆开的果实，三十二颗末石。",
      "当工作准备好时再回来。"
    ],
    "quest.end_survey.chorus_trail.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.end_survey.chorus_trail.stage.work.dialogue.offer.label": "紫颂",
