{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.end_survey.city_lantern.description": "使用杆、炮弹和最终的塔调查来完成这个末地城分支。",
    "quest.end_survey.city_lantern.stage.return.dialogue.turn_in.label": "关于回家之路",
    "quest.end_survey.city_lantern.stage.return.dialogue.turn_in.lines": [
      "苍白的塔楼和归家之路现在共用一张地图。市分公司已竣工。",
      "末地城有一个方向，一个光明的回报，以及更少的两个潜影贝的秘密。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.end_survey.city_lantern.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.end_survey.city_lantern.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.end_survey.city_lantern.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "苍白的塔楼和归家之路现在共用一张地图。市分公司已竣工。",
      "末地城有一个方向，一个光明的回报，以及更少的两个潜影贝的秘密。"
    ],
    "quest.end_survey.city_lantern.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.end_survey.city_lantern.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.end_survey.city_lantern.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.end_survey.city_lantern.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "回家之路目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.end_survey.city_lantern.stage.return.scene.turn_in_wait.lines": [
      "塔楼勘察，放置了十二根末端杆，两枚炮弹返回。",
      "当工作准备好时再回来。"
    ],
    "quest.end_survey.city_lantern.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.end_survey.city_lantern.stage.work.dialogue.offer.label": "归家之路",
    "quest.end_survey.city_lantern.stage.work.dialogue.offer.lines": [
      "标记了一盏城市之光。这次探险的结束调查也必须让归家之路变得清晰可见。",
      "爬上塔楼，沿着返回路设置末端杆，并回收炮弹以供存档。",
      "调查标记的末地城，放置 12 个末地棒，并带来 2 个潜影贝壳。"
    ],
    "quest.end_survey.city_lantern.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.end_survey.city_lantern.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.end_survey.city_lantern.stage.work.dialogue.reminder.label": "关于回家之路",
    "quest.end_survey.city_lantern.stage.work.dialogue.reminder.lines": [
      "塔楼勘察，放置了十二根末端杆，两枚炮弹返回。",
      "调查标记的末地城，放置 12 个末地棒，并带来 2 个潜影贝壳。",
      "爬上塔楼，沿着返回路设置末端杆，并回收炮弹以供存档。"
    ],
    "quest.end_survey.city_lantern.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.end_survey.city_lantern.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.end_survey.city_lantern.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.end_survey.city_lantern.stage.work.objective.bring_shells.tracker.complete_text": "潜影贝壳已准备就绪。",
    "quest.end_survey.city_lantern.stage.work.objective.bring_shells.tracker.text": "带 2 个潜影贝壳来存档。",
    "quest.end_survey.city_lantern.stage.work.objective.place_rods.tracker.complete_text": "返回标记亮起。",
    "quest.end_survey.city_lantern.stage.work.objective.place_rods.tracker.text": "放置 12 个末端杆作为返回标记。",
    "quest.end_survey.city_lantern.stage.work.objective.survey_city.tracker.complete_text": "末地城塔已被调查。",
    "quest.end_survey.city_lantern.stage.work.objective.survey_city.tracker.text": "调查标记的末地城塔。",
    "quest.end_survey.city_lantern.stage.work.scene.abandon_confirm.lines": [
      "把归家之路放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.end_survey.city_lantern.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.end_survey.city_lantern.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "回家之路目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.decline.lines": [
      "那么就不要爬上一座你找不到下来路的塔。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.leave.lines": [
      "塔楼勘察，放置了十二根末端杆，两枚炮弹返回。",
      "当工作准备好时再回来。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "塔楼勘察，放置了十二根末端杆，两枚炮弹返回。",
      "调查标记的末地城，放置 12 个末地棒，并带来 2 个潜影贝壳。",
      "爬上塔楼，沿着返回路设置末端杆，并回收炮弹以供存档。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "回家之路目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "归家之路暂时已经定下来了。",
      "这项工作已经被计算在内。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.start_quest.action.start.lines.started": [
      "将第一根杆放在网关在你身后消失的地方。骄傲是一个糟糕的回报标志。",
      "调查标记的末地城，放置 12 个末地棒，并带来 2 个潜影贝壳。"
    ],
    "quest.end_survey.city_lantern.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "回家之路目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.end_survey.city_lantern.stage.work.ui.tracker_text": "调查标记的末地城，放置 12 个末地棒，并带来 2 个潜影贝壳。",
    "quest.end_survey.city_lantern.title": "归家之路"
  }
}
