{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.echo_trade.description": "返回古城并恢复档案的回响碎片。",
    "quest.village_commissions.echo_trade.stage.return.dialogue.turn_in.label": "关于回响",
    "quest.village_commissions.echo_trade.stage.return.dialogue.turn_in.lines": [
      "即使包裹着羊毛，这些碎片听起来也像是一个有记忆的房间。",
      "档案有其回响。你已经获得了更丰厚的回报。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.echo_trade.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.echo_trade.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.echo_trade.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "即使包裹着羊毛，这些碎片听起来也像是一个有记忆的房间。",
      "档案有其回响。你已经获得了更丰厚的回报。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.echo_trade.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.echo_trade.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.echo_trade.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.echo_trade.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "回响 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.echo_trade.stage.return.scene.turn_in_wait.lines": [
      "来自标记城市的两块回响碎片。如果黑暗开始倾听，就停止行动。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.echo_trade.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.echo_trade.stage.work.dialogue.offer.label": "回响",
    "quest.village_commissions.echo_trade.stage.work.dialogue.offer.lines": [
      "该档案有一个回响碎片和太多问题。",
      "重回一座古城，轻轻行走，多带两段记忆。",
      "到达标记的古城并带上 2 个回响碎片。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.echo_trade.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.echo_trade.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.echo_trade.stage.work.dialogue.reminder.label": "关于回响",
    "quest.village_commissions.echo_trade.stage.work.dialogue.reminder.lines": [
      "来自标记城市的两块回响碎片。如果黑暗开始倾听，就停止行动。",
      "到达标记的古城并带上 2 个回响碎片。",
      "重回一座古城，轻轻行走，多带两段记忆。"
    ],
    "quest.village_commissions.echo_trade.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.echo_trade.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.echo_trade.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.echo_trade.stage.work.objective.bring_echoes.tracker.complete_text": "回响碎片被包裹起来。",
    "quest.village_commissions.echo_trade.stage.work.objective.bring_echoes.tracker.text": "带2个回响碎片。",
    "quest.village_commissions.echo_trade.stage.work.objective.visit_city.tracker.complete_text": "古城已被重新审视。",
    "quest.village_commissions.echo_trade.stage.work.objective.visit_city.tracker.text": "到达标记的古城。",
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_confirm.lines": [
      "把回响放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "回响 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.decline.lines": [
      "好的。当恐惧让安静的地方保持安静时，恐惧是有用的。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.leave.lines": [
      "来自标记城市的两块回响碎片。如果黑暗开始倾听，就停止行动。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "来自标记城市的两块回响碎片。如果黑暗开始倾听，就停止行动。",
      "到达标记的古城并带上 2 个回响碎片。",
      "重回一座古城，轻轻行走，多带两段记忆。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "回响 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "回响 现在已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.start_quest.action.start.lines.started": [
      "脚下有羊毛。地下没有钟声，没有箭，也没有骄傲的演讲。",
      "到达标记的古城并带上 2 个回响碎片。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.echo_trade.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "回响 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.echo_trade.stage.work.ui.tracker_text": "到达标记的古城并带上 2 个回响碎片。",
    "quest.village_commissions.echo_trade.title": "回响"
  }
}
