{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.dragon_sample.description": "瓶龙息和归端石要仔细研究。",
    "quest.village_commissions.dragon_sample.stage.return.dialogue.turn_in.label": "关于瓶中的龙息",
    "quest.village_commissions.dragon_sample.stage.return.dialogue.turn_in.lines": [
      "瓶子是密封的，石头也没有发出嗡嗡声。我们可能会稍后再开一间。",
      "龙的风暴的一部分，在没有打破瓶子或你的情况下被捕获。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.dragon_sample.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.dragon_sample.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "瓶子是密封的，石头也没有发出嗡嗡声。我们可能会稍后再开一间。",
      "龙的风暴的一部分，在没有打破瓶子或你的情况下被捕获。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "瓶中的龙息目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.scene.turn_in_wait.lines": [
      "四个末影人、四瓶呼吸和三十二块末影石。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.dragon_sample.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.offer.label": "瓶中的龙息",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.offer.lines": [
      "末日喷泉之上，龙息缭绕，紫罗兰色，完全不肯理智。",
      "装一点它，清除那些盯着看的当地人，并带上石头进行比较。",
      "击败 4 个末影人，然后带来 4 个龙息和 32 个末影石。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.reminder.label": "关于瓶中的龙息",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.reminder.lines": [
      "四个末影人、四瓶呼吸和三十二块末影石。",
      "击败 4 个末影人，然后带来 4 个龙息和 32 个末影石。",
      "装一点它，清除那些盯着看的当地人，并带上石头进行比较。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.dragon_sample.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.dragon_sample.stage.work.objective.bring_breath.tracker.complete_text": "龙息被封印。",
    "quest.village_commissions.dragon_sample.stage.work.objective.bring_breath.tracker.text": "带上4瓶龙息。",
    "quest.village_commissions.dragon_sample.stage.work.objective.bring_end_stone.tracker.complete_text": "末地石样品已准备就绪。",
    "quest.village_commissions.dragon_sample.stage.work.objective.bring_end_stone.tracker.text": "带上32块末地石。",
    "quest.village_commissions.dragon_sample.stage.work.objective.clear_endermen.tracker.complete_text": "末影人已被清除。",
    "quest.village_commissions.dragon_sample.stage.work.objective.clear_endermen.tracker.text": "在末日击败 4 名末影人。",
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_confirm.lines": [
      "把瓶中的龙息放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "瓶中的龙息目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.decline.lines": [
      "任何在末地之地发出紫色光芒的东西都不需要匆忙收集。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.leave.lines": [
      "四个末影人、四瓶呼吸和三十二块末影石。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "四个末影人、四瓶呼吸和三十二块末影石。",
      "击败 4 个末影人，然后带来 4 个龙息和 32 个末影石。",
      "装一点它，清除那些盯着看的当地人，并带上石头进行比较。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "瓶中的龙息目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "瓶中的龙息现在已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.start_quest.action.start.lines.started": [
      "第一是玻璃瓶，第二是雕刻南瓜，第三是信心。",
      "击败 4 个末影人，然后带来 4 个龙息和 32 个末影石。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "瓶中的龙息目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.dragon_sample.stage.work.ui.tracker_text": "击败 4 个末影人，然后带来 4 个龙息和 32 个末影石。",
    "quest.village_commissions.dragon_sample.title": "瓶中的龙息"
  }
