{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.powder_run.description": "消灭农场外的苦力怕并回收它们的火药。",
    "quest.village_commissions.powder_run.stage.return.dialogue.turn_in.label": "关于苦力怕",
    "quest.village_commissions.powder_run.stage.return.dialogue.turn_in.lines": [
      "没有新的弹坑，粉末也干燥了。比我希望的要好。",
      "今晚，农场可以在黑暗中安然入睡，不会发出嘶嘶声。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.powder_run.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.powder_run.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.powder_run.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "没有新的弹坑，粉末也干燥了。比我希望的要好。",
      "今晚，农场可以在黑暗中安然入睡，不会发出嘶嘶声。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.powder_run.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.powder_run.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.powder_run.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.powder_run.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "苦力怕 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.powder_run.stage.return.scene.turn_in_wait.lines": [
      "四颗苦力怕和十二颗火药，搬运得非常小心。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.powder_run.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.powder_run.stage.work.dialogue.offer.label": "苦力怕",
    "quest.village_commissions.powder_run.stage.work.dialogue.offer.lines": [
      "爬山虎聚集在农场旁，它们和庄稼一样绿，但栅栏的情况更糟。",
      "在有人将火炬扔到附近之前，将它们稀释并密封粉末。",
      "击败 4 个苦力怕并带来 12 个火药。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.powder_run.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.powder_run.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.powder_run.stage.work.dialogue.reminder.label": "关于苦力怕",
    "quest.village_commissions.powder_run.stage.work.dialogue.reminder.lines": [
      "四颗苦力怕和十二颗火药，搬运得非常小心。",
      "击败 4 个苦力怕并带来 12 个火药。",
      "在有人将火炬扔到附近之前，将它们稀释并密封粉末。"
    ],
    "quest.village_commissions.powder_run.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.powder_run.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.powder_run.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.powder_run.stage.work.objective.bring_gunpowder.tracker.complete_text": "火药是密封的。",
    "quest.village_commissions.powder_run.stage.work.objective.bring_gunpowder.tracker.text": "带12个火药。",
    "quest.village_commissions.powder_run.stage.work.objective.clear_creepers.tracker.complete_text": "四个苦力怕已被清除。",
    "quest.village_commissions.powder_run.stage.work.objective.clear_creepers.tracker.text": "击败 4 个苦力怕。",
    "quest.village_commissions.powder_run.stage.work.scene.abandon_confirm.lines": [
      "把苦力怕放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.powder_run.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.powder_run.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "苦力怕 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.decline.lines": [
      "日落后远离高高的草丛。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.leave.lines": [
      "四颗苦力怕和十二颗火药，搬运得非常小心。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "四颗苦力怕和十二颗火药，搬运得非常小心。",
      "击败 4 个苦力怕并带来 12 个火药。",
      "在有人将火炬扔到附近之前，将它们稀释并密封粉末。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "苦力怕 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "苦力怕现在已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.start_quest.action.start.lines.started": [
      "不要让他们选择距离。盾牌比墙便宜。",
      "击败 4 个苦力怕并带来 12 个火药。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.powder_run.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "苦力怕 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.powder_run.stage.work.ui.tracker_text": "击败 4 个苦力怕并带来 12 个火药。",
    "quest.village_commissions.powder_run.title": "苦力怕"
  }
}
