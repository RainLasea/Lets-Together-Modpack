{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.apiary_smoke.description": "照料村庄的蜂巢并带来蜂巢作为新鲜的框架。",
    "quest.village_commissions.apiary_smoke.stage.return.dialogue.turn_in.label": "关于熏蜂巢",
    "quest.village_commissions.apiary_smoke.stage.return.dialogue.turn_in.lines": [
      "框架很干净，蜜蜂也保持着淬炼。干得好。",
      "这个蜂巢会在花谢之前启动另一个蜂巢。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.apiary_smoke.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.apiary_smoke.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "框架很干净，蜜蜂也保持着淬炼。干得好。",
      "这个蜂巢会在花谢之前启动另一个蜂巢。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "烟熏蜂巢 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.scene.turn_in_wait.lines": [
      "两个蜂巢和六个蜂窝。如果嗡嗡声变大，请退后一步。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.apiary_smoke.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.offer.label": "烟熏蜂巢",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.offer.lines": [
      "蜂箱很拥挤，蜜蜂可不想再用笨手笨脚的双手。",
      "给框架熏烟，照顾两个蜂箱，并为下一组盒子带来六个蜂窝。",
      "照顾 2 个蜂巢并带来 6 个蜂巢。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.reminder.label": "关于熏蜂巢",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.reminder.lines": [
      "两个蜂巢和六个蜂窝。如果嗡嗡声变大，请退后一步。",
      "照顾 2 个蜂巢并带来 6 个蜂巢。",
      "给框架熏烟，照顾两个蜂箱，并为下一组盒子带来六个蜂窝。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.apiary_smoke.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.apiary_smoke.stage.work.objective.bring_honeycomb.tracker.complete_text": "蜂窝准备好了。",
    "quest.village_commissions.apiary_smoke.stage.work.objective.bring_honeycomb.tracker.text": "为新框架带来 6 个蜂窝。",
    "quest.village_commissions.apiary_smoke.stage.work.objective.tend_hives.tracker.complete_text": "蜂巢已被照料。",
    "quest.village_commissions.apiary_smoke.stage.work.objective.tend_hives.tracker.text": "安全地照料 2 个蜂巢或蜂巢。",
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_confirm.lines": [
      "把熏蜂巢放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "烟熏蜂巢 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.decline.lines": [
      "公平的。蜜蜂能闻到怀疑的味道，至少农民们坚持这么认为。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.leave.lines": [
      "两个蜂巢和六个蜂窝。如果嗡嗡声变大，请退后一步。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "两个蜂巢和六个蜂窝。如果嗡嗡声变大，请退后一步。",
      "照顾 2 个蜂巢并带来 6 个蜂巢。",
      "给框架熏烟，照顾两个蜂箱，并为下一组盒子带来六个蜂窝。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "烟熏蜂巢 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "目前，烟熏蜂巢 已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.start_quest.action.start.lines.started": [
      "慢慢移动。蜜蜂对挥动的手臂的记忆比对道歉的记忆更深刻。",
      "照顾 2 个蜂巢并带来 6 个蜂巢。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "烟熏蜂巢 目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.apiary_smoke.stage.work.ui.tracker_text": "照顾 2 个蜂巢并带来 6 个蜂巢。",
    "quest.village_commissions.apiary_smoke.title": "烟熏蜂巢"
  }
}
