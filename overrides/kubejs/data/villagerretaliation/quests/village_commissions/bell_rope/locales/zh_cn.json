{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.bell_rope.description": "为村铃和动物围栏提供绳索和引线。",
    "quest.village_commissions.bell_rope.stage.return.dialogue.turn_in.label": "关于磨损的绳索",
    "quest.village_commissions.bell_rope.stage.return.dialogue.turn_in.lines": [
      "辫子会固定住，动物也会固定住。这样就少了两个顾虑。",
      "绳索坚韧，结健全。铃又可以说话了。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.bell_rope.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.bell_rope.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.bell_rope.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "辫子会固定住，动物也会固定住。这样就少了两个顾虑。",
      "绳索坚韧，结健全。铃又可以说话了。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.bell_rope.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.bell_rope.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.bell_rope.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.bell_rope.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "磨损绳索目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.bell_rope.stage.return.scene.turn_in_wait.lines": [
      "十六根绳子用于铃铛辫子，两根导线用于笔。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.bell_rope.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.bell_rope.stage.work.dialogue.offer.label": "磨损的绳索",
    "quest.village_commissions.bell_rope.stage.work.dialogue.offer.lines": [
      "怀疑 的同一周内，铃绳磨损，两根笔线消失。",
      "在其他东西脱落之前，带上新辫子的绳子和两根导线。",
      "带16根绳子和2根导线。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.bell_rope.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.bell_rope.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.bell_rope.stage.work.dialogue.reminder.label": "关于磨损的绳索",
    "quest.village_commissions.bell_rope.stage.work.dialogue.reminder.lines": [
      "十六根绳子用于铃铛辫子，两根导线用于笔。",
      "带16根绳子和2根导线。",
      "在其他东西脱落之前，带上新辫子的绳子和两根导线。"
    ],
    "quest.village_commissions.bell_rope.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.bell_rope.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.bell_rope.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.bell_rope.stage.work.objective.bring_leads.tracker.complete_text": "线索已经准备好了。",
    "quest.village_commissions.bell_rope.stage.work.objective.bring_leads.tracker.text": "为笔带来 2 根引线。",
    "quest.village_commissions.bell_rope.stage.work.objective.bring_string.tracker.complete_text": "绳子准备好了。",
    "quest.village_commissions.bell_rope.stage.work.objective.bring_string.tracker.text": "带16根绳子来编织绳子。",
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_confirm.lines": [
      "把磨损的绳子放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "磨损绳索目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.decline.lines": [
      "然后我们会仔细地敲响并打更好的结。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.leave.lines": [
      "十六根绳子用于铃铛辫子，两根导线用于笔。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "十六根绳子用于铃铛辫子，两根导线用于笔。",
      "带16根绳子和2根导线。",
      "在其他东西脱落之前，带上新辫子的绳子和两根导线。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "磨损绳索目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "磨损的绳索目前已经解决。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.start_quest.action.start.lines.started": [
      "只有当有人拉动铃时，铃才会发出警告。使绳子粗壮。",
      "带16根绳子和2根导线。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.bell_rope.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "磨损绳索目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.bell_rope.stage.work.ui.tracker_text": "带16根绳子和2根导线。",
    "quest.village_commissions.bell_rope.title": "磨损的绳索"
  }
