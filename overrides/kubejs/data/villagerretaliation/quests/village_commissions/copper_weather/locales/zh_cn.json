{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.copper_weather.description": "为车间开采铜，并返回屋顶的成品块。",
    "quest.village_commissions.copper_weather.stage.return.dialogue.turn_in.label": "关于铜制屋顶",
    "quest.village_commissions.copper_weather.stage.return.dialogue.turn_in.lines": [
      "重量适中，边角干净。雨水会给这些方块赋予颜色。",
      "当今天的修复已是老故事时，这种铜仍然会发生变化。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.copper_weather.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.copper_weather.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.copper_weather.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "重量适中，边角干净。雨水会给这些方块赋予颜色。",
      "当今天的修复已是老故事时，这种铜仍然会发生变化。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.copper_weather.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.copper_weather.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.copper_weather.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.copper_weather.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "铜制屋顶目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.copper_weather.stage.return.scene.turn_in_wait.lines": [
      "十二块铜矿石破碎，两块完整的铜块返回。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.copper_weather.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.copper_weather.stage.work.dialogue.offer.label": "铜制屋顶",
    "quest.village_commissions.copper_weather.stage.work.dialogue.offer.lines": [
      "新屋顶需要能够与村庄一起老化而不是生锈的铜。",
      "进行适当的接缝，然后将部分拉料压成实心块。",
      "开采 12 个铜矿石块并带来 2 个铜块。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.copper_weather.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.copper_weather.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.copper_weather.stage.work.dialogue.reminder.label": "关于铜制屋顶",
    "quest.village_commissions.copper_weather.stage.work.dialogue.reminder.lines": [
      "十二块铜矿石破碎，两块完整的铜块返回。",
      "开采 12 个铜矿石块并带来 2 个铜块。",
      "进行适当的接缝，然后将部分拉料压成实心块。"
    ],
    "quest.village_commissions.copper_weather.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.copper_weather.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.copper_weather.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.copper_weather.stage.work.objective.bring_copper.tracker.complete_text": "铜块已准备就绪。",
    "quest.village_commissions.copper_weather.stage.work.objective.bring_copper.tracker.text": "带2块铜块。",
    "quest.village_commissions.copper_weather.stage.work.objective.mine_copper.tracker.complete_text": "铜缝已加工完毕。",
    "quest.village_commissions.copper_weather.stage.work.objective.mine_copper.tracker.text": "开采 12 个铜矿块。",
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_confirm.lines": [
      "把铜制屋顶放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "铜制屋顶目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.decline.lines": [
      "这样屋顶的普通石头就可以保持更长的时间。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.leave.lines": [
      "十二块铜矿石破碎，两块完整的铜块返回。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "十二块铜矿石破碎，两块完整的铜块返回。",
      "开采 12 个铜矿石块并带来 2 个铜块。",
      "进行适当的接缝，然后将部分拉料压成实心块。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "铜制屋顶目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "铜制屋顶目前已经确定。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.start_quest.action.start.lines.started": [
      "跟随绿色斑点。斯通很少为其他任何东西做如此鲜明的广告。",
      "开采 12 个铜矿石块并带来 2 个铜块。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.copper_weather.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "铜制屋顶目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.copper_weather.stage.work.ui.tracker_text": "开采 12 个铜矿石块并带来 2 个铜块。",
    "quest.village_commissions.copper_weather.title": "铜制屋顶"
  }
}
