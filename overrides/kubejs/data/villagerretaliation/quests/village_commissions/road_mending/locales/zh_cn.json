{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.road_mending.description": "修复破旧的乡村道路并带上燧石作为排水床。",
    "quest.village_commissions.road_mending.stage.return.dialogue.turn_in.label": "关于路面坑洞",
    "quest.village_commissions.road_mending.stage.return.dialogue.turn_in.lines": [
      "这条路将运送靴子和手推车，但也不会被吞没。",
      "脚下坚固，并倾斜以备雨水。石匠同意了。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.road_mending.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.road_mending.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.road_mending.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "这条路将运送靴子和手推车，但也不会被吞没。",
      "脚下坚固，并倾斜以备雨水。石匠同意了。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.road_mending.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.road_mending.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.road_mending.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.road_mending.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "路面坑洞现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.road_mending.stage.return.scene.turn_in_wait.lines": [
      "铺设了二十四块砾石，八块燧石返回潮湿的边缘。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.road_mending.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.road_mending.stage.work.dialogue.offer.label": "路面坑洞",
    "quest.village_commissions.road_mending.stage.work.dialogue.offer.lines": [
      "路上的坑比小路还多，尤其是在车转弯的地方。",
      "铺设新鲜的砾石并带上燧石，这样雨水就可以去到其他地方。",
      "放置 24 个砾石并带来 8 个火石。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.road_mending.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.road_mending.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.road_mending.stage.work.dialogue.reminder.label": "关于路面坑洞",
    "quest.village_commissions.road_mending.stage.work.dialogue.reminder.lines": [
      "铺设了二十四块砾石，八块燧石返回潮湿的边缘。",
      "放置 24 个砾石并带来 8 个火石。",
      "铺设新鲜的砾石并带上燧石，这样雨水就可以去到其他地方。"
    ],
    "quest.village_commissions.road_mending.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.road_mending.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.road_mending.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.road_mending.stage.work.objective.bring_flint.tracker.complete_text": "火石准备好了。",
    "quest.village_commissions.road_mending.stage.work.objective.bring_flint.tracker.text": "带8块火石用于排水床。",
    "quest.village_commissions.road_mending.stage.work.objective.lay_gravel.tracker.complete_text": "砾石修复已铺设。",
    "quest.village_commissions.road_mending.stage.work.objective.lay_gravel.tracker.text": "放置 24 块碎石用于道路维修。",
    "quest.village_commissions.road_mending.stage.work.scene.abandon_confirm.lines": [
      "把路面坑洞放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.road_mending.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.road_mending.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "路面坑洞现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.decline.lines": [
      "那么，请注意东弯。它已经吃掉了一个车轮。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.leave.lines": [
      "铺设了二十四块砾石，八块燧石返回潮湿的边缘。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "铺设了二十四块砾石，八块燧石返回潮湿的边缘。",
      "放置 24 个砾石并带来 8 个火石。",
      "铺设新鲜的砾石并带上燧石，这样雨水就可以去到其他地方。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "路面坑洞现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "路面坑洞现在已经解决了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.start_quest.action.start.lines.started": [
      "将其包装牢固。松散的道路只会将洞移到新的地方。",
      "放置 24 个砾石并带来 8 个火石。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.road_mending.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "路面坑洞现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.road_mending.stage.work.ui.tracker_text": "放置 24 个砾石并带来 8 个火石。",
    "quest.village_commissions.road_mending.title": "路面坑洞"
  }
}
