{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.village_commissions.wither_ash.description": "狩猎枯萎骷髅并安全地找回黑色的遗骸。",
    "quest.village_commissions.wither_ash.stage.return.dialogue.turn_in.label": "关于黑色骸骨",
    "quest.village_commissions.wither_ash.stage.return.dialogue.turn_in.lines": [
      "灰烬冰冷，骨头静止。我们现在可以安全地研究它们了。",
      "你把堡垒的影子带回家，却没有让它跟着你。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.village_commissions.wither_ash.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.village_commissions.wither_ash.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.village_commissions.wither_ash.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "灰烬冰冷，骨头静止。我们现在可以安全地研究它们了。",
      "你把堡垒的影子带回家，却没有让它跟着你。",
      "这样就解决了。村里一定会好好利用这一点。"
    ],
    "quest.village_commissions.wither_ash.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "仍然缺少一些东西。在我关闭笔记之前检查日记。",
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.village_commissions.wither_ash.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.village_commissions.wither_ash.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.village_commissions.wither_ash.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "黑色骸骨目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.wither_ash.stage.return.scene.turn_in_wait.lines": [
      "六具凋灵骷髅，二十四块煤炭，十二块骨头。将遗体包裹起来。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.wither_ash.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.village_commissions.wither_ash.stage.work.dialogue.offer.label": "黑色骸骨",
    "quest.village_commissions.wither_ash.stage.work.dialogue.offer.lines": [
      "要塞的骨头又开始行走了，黑色的火焰从未温暖过任何东西。",
      "击碎六只凋灵骷髅，带回灰烬没有隐藏的东西。",
      "击败 6 个凋灵骷髅，然后带来 24 个煤炭和 12 个骨头。我会让回报值得付出的努力。"
    ],
    "quest.village_commissions.wither_ash.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.village_commissions.wither_ash.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.village_commissions.wither_ash.stage.work.dialogue.reminder.label": "关于黑色骸骨",
    "quest.village_commissions.wither_ash.stage.work.dialogue.reminder.lines": [
      "六具凋灵骷髅，二十四块煤炭，十二块骨头。将遗体包裹起来。",
      "击败 6 个凋灵骷髅，然后带来 24 个煤炭和 12 个骨头。",
      "击碎六只凋灵骷髅，带回灰烬没有隐藏的东西。"
    ],
    "quest.village_commissions.wither_ash.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.village_commissions.wither_ash.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.village_commissions.wither_ash.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.village_commissions.wither_ash.stage.work.objective.bring_bones.tracker.complete_text": "骨头被封印了。",
    "quest.village_commissions.wither_ash.stage.work.objective.bring_bones.tracker.text": "带 12 块骨头来研究。",
    "quest.village_commissions.wither_ash.stage.work.objective.bring_coal.tracker.complete_text": "黑煤就准备好了。",
    "quest.village_commissions.wither_ash.stage.work.objective.bring_coal.tracker.text": "从要塞狩猎中获取 24 块煤炭。",
    "quest.village_commissions.wither_ash.stage.work.objective.hunt_skeletons.tracker.complete_text": "六只凋灵骷髅倒下了。",
    "quest.village_commissions.wither_ash.stage.work.objective.hunt_skeletons.tracker.text": "击败 6 个凋灵骷髅。",
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_confirm.lines": [
      "把黑色骸骨头放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "黑色骸骨目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.decline.lines": [
      "下界要塞并不是一个值得羞于参观的地方。",
      "另一双手可能会接住它，或者您可以稍后再问。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.leave.lines": [
      "六具凋灵骷髅，二十四块煤炭，十二块骨头。将遗体包裹起来。",
      "当工作准备好时再回来。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "六具凋灵骷髅，二十四块煤炭，十二块骨头。将遗体包裹起来。",
      "击败 6 个凋灵骷髅，然后带来 24 个煤炭和 12 个骨头。",
      "击碎六只凋灵骷髅，带回灰烬没有隐藏的东西。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
      "黑色骸骨目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.start_quest.action.start.lines.already_completed": [
      "黑色骸骨现在已经确定了。",
      "这项工作已经被计算在内。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.start_quest.action.start.lines.locate_failed": [
      "我在这里找不到值得信赖的标记。等道路畅通后再询问。",
      "今天地图不会确定安全目的地。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.start_quest.action.start.lines.started": [
      "牛奶可以清除枯萎的血液。它对糟糕的判断力没有任何作用，所以带上牛奶和判断力。",
      "击败 6 个凋灵骷髅，然后带来 24 个煤炭和 12 个骨头。",
      "好的。我会为你带回来的东西保留一个地方。"
    ],
    "quest.village_commissions.wither_ash.stage.work.scene.start_quest.action.start.lines.unavailable": [
      "黑色骸骨目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.village_commissions.wither_ash.stage.work.ui.tracker_text": "击败 6 个凋灵骷髅，然后带来 24 个煤炭和 12 个骨头。",
    "quest.village_commissions.wither_ash.title": "黑色骸骨"
  }
}
