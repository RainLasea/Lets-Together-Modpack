{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.green_thumb.rich_earth.description": "用工作堆和深厚的肥沃床完成堆肥 路线。",
    "quest.green_thumb.rich_earth.stage.return.dialogue.turn_in.label": "关于富地",
    "quest.green_thumb.rich_earth.stage.return.dialogue.turn_in.lines": [
      "每张床都已准备就绪。堆肥场已完成。",
      "没有浪费，每一行都吃饱了。这是一个值得保留的领域。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.green_thumb.rich_earth.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.green_thumb.rich_earth.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.green_thumb.rich_earth.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "每张床都已准备就绪。堆肥场已完成。",
      "没有浪费，每一行都吃饱了。这是一个值得保留的领域。"
    ],
