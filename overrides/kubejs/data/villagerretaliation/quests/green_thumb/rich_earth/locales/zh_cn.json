    "quest.green_thumb.rich_earth.stage.work.scene.abandon_confirm.lines": [
      "把富裕的地球放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
    "quest.green_thumb.rich_earth.stage.work.scene.abandon_confirm.response.confirm.label": "把它放在一边。",
    "quest.green_thumb.rich_earth.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "肥沃土地目前尚未开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.decline.lines": [
      "无论我们是否观看，这些堆都会继续烹饪。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.leave.lines": [
      "堆肥机转八圈，三十二块泥土，二十四块骨粉。",
      "当工作准备好时再回来。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "堆肥机转八圈，三十二块泥土，二十四块骨粉。",
      "堆肥 8 次，然后带来 32 块泥土和 24 块骨粉。",
      "翻堆，抬高床，并给第一口种植井施肥。"
    ],
    "quest.green_thumb.rich_earth.stage.work.scene.reminder_details.action.remind.lines.unavailable": [
