{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "quest.green_thumb.new_furrows.description": "为村庄的新田地准备种子、水和好锄头。",
    "quest.green_thumb.new_furrows.stage.return.dialogue.turn_in.label": "关于弗罗斯",
    "quest.green_thumb.new_furrows.stage.return.dialogue.turn_in.lines": [
      "这就是一块光秃秃的土地变成一片田野所需要的一切。",
      "田垄可以在日出时开始。你给了他们一个公平的开始。",
      "在我关闭笔记之前让我看看完整的作品。"
    ],
    "quest.green_thumb.new_furrows.stage.return.dialogue.turn_in.response.complete.label": "交出工作。",
    "quest.green_thumb.new_furrows.stage.return.dialogue.turn_in.response.leave.label": "还没有。",
    "quest.green_thumb.new_furrows.stage.return.scene.complete_quest.action.turn_in.lines.completed": [
      "这就是一块光秃秃的土地变成一片田野所需要的一切。",
      "田垄可以在日出时开始。你给了他们一个公平的开始。"
    ],
    "quest.green_thumb.new_furrows.stage.return.scene.complete_quest.action.turn_in.lines.missing_objectives": [
      "完整的工作尚未准备好进行计算。"
    ],
    "quest.green_thumb.new_furrows.stage.return.scene.complete_quest.action.turn_in.lines.missing_proof": [
      "在我们解决这个问题之前，请带上证据。",
      "我需要在这里提交完整的内容，而不仅仅是故事。"
    ],
    "quest.green_thumb.new_furrows.stage.return.scene.complete_quest.action.turn_in.lines.missing_target": [
      "原料 背后需要一个真正的目的地。",
      "在我们称之为完成之前到达标记的地方。"
    ],
    "quest.green_thumb.new_furrows.stage.return.scene.complete_quest.action.turn_in.lines.unavailable": [
      "田垄现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.green_thumb.new_furrows.stage.return.scene.turn_in_wait.lines": [
      "行的种子、一把铁锄头和一桶水。",
      "当工作准备好时再回来。"
    ],
    "quest.green_thumb.new_furrows.stage.return.ui.tracker_text": "返回任务给予者。",
    "quest.green_thumb.new_furrows.stage.work.dialogue.offer.label": "田垄",
    "quest.green_thumb.new_furrows.stage.work.dialogue.offer.lines": [
      "最后一道栅栏之外有良好的地面，但良好的地面仍然需要双手。",
      "带上种子、水和一把能在多行中存活的锄头。",
      "带24颗小麦种子、一把铁锄头和一个水桶。"
    ],
    "quest.green_thumb.new_furrows.stage.work.dialogue.offer.response.accept.label": "我能做到。",
    "quest.green_thumb.new_furrows.stage.work.dialogue.offer.response.decline.label": "现在不行。",
    "quest.green_thumb.new_furrows.stage.work.dialogue.reminder.label": "关于弗罗斯",
    "quest.green_thumb.new_furrows.stage.work.dialogue.reminder.lines": [
      "行的种子、一把铁锄头和一桶水。",
      "带24颗小麦种子、一把铁锄头和一个水桶。",
      "带上种子、水和一把能在多行中存活的锄头。"
    ],
    "quest.green_thumb.new_furrows.stage.work.dialogue.reminder.response.abandon.label": "把这个放在一边。",
    "quest.green_thumb.new_furrows.stage.work.dialogue.reminder.response.details.label": "重复该工作。",
    "quest.green_thumb.new_furrows.stage.work.dialogue.reminder.response.leave.label": "我有。",
    "quest.green_thumb.new_furrows.stage.work.objective.bring_seeds.tracker.complete_text": "种子袋已经准备好了。",
    "quest.green_thumb.new_furrows.stage.work.objective.bring_seeds.tracker.text": "带24颗小麦种子。",
    "quest.green_thumb.new_furrows.stage.work.objective.carry_hoe.tracker.complete_text": "铁锄头已经准备好了。",
    "quest.green_thumb.new_furrows.stage.work.objective.carry_hoe.tracker.text": "携带一把铁锄头去新田。",
    "quest.green_thumb.new_furrows.stage.work.objective.carry_water.tracker.complete_text": "水桶准备好了。",
