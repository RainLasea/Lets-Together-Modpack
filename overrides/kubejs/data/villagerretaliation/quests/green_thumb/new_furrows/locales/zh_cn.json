    "quest.green_thumb.new_furrows.stage.work.scene.abandon_confirm.lines": [
      "把田垄放在一边？",
      "如果你确定的话我可以把你的名字从工作中删除。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.abandon_confirm.response.cancel.label": "保持打开状态。",
