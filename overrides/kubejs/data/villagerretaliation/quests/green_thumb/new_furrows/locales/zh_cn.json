    "quest.green_thumb.new_furrows.stage.work.scene.abandon_quest.action.abandon.lines.abandoned": [
      "好的。我会从工作中清除你的名字。",
      "便条收起来了。你可以稍后再问。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.abandon_quest.action.abandon.lines.abandoned_cooldown": [
      "我会把这张纸条先搁置一段时间，然后再重新发布。",
      "在你再次提出要求之前，先让工作休息一下。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.abandon_quest.action.abandon.lines.unavailable": [
      "田垄现在还没有开放。",
      "村子还没有准备好把这项工作交给你。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.decline.lines": [
      "地会保留。我们不应该在没有计划的情况下打开它。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.leave.lines": [
      "行的种子、一把铁锄头和一桶水。",
      "当工作准备好时再回来。"
    ],
    "quest.green_thumb.new_furrows.stage.work.scene.reminder_details.action.remind.lines.reminder": [
      "行的种子、一把铁锄头和一桶水。",
      "带24颗小麦种子、一把铁锄头和一个水桶。",
      "带上种子、水和一把能在多行中存活的锄头。"
