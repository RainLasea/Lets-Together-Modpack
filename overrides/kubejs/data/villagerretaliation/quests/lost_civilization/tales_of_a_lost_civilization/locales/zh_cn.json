    "quest.lost_civilization.tales_of_a_lost_civilization.stage.survey.scene.decline.lines": [
      "然后将地图折叠起来。有些地方的耐心却是人们所没有的。",
      "公平的。一个学会保持沉默的城市可以再等一会儿。"
    ],
    "quest.lost_civilization.tales_of_a_lost_civilization.stage.survey.scene.reminder_details.action.remind.lines.reminder": [
